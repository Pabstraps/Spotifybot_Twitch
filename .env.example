# ===== Streamer.bot =====
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8080
# Déjala vacía si el WebSocket Server NO tiene autenticación
STREAMERBOT_PASSWORD=

# ===== Spotify (https://developer.spotify.com/dashboard) =====
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ID de la playlist (lo que va después de /playlist/ en el enlace, sin el ?si=...)
SPOTIFY_PLAYLIST_ID=
# Debe coincidir EXACTAMENTE con el Redirect URI de tu app de Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# País para la disponibilidad de canciones (código de 2 letras)
SPOTIFY_MARKET=MX

# ===== Recompensa de puntos de canal =====
# Usa el nombre exacto de la recompensa O su ID (el ID es más robusto)
REWARD_TITLE=Pedir canción
REWARD_ID=

# ===== Mensajes =====
PLAYLIST_NAME=la playlist del stream
# Nombre de la acción en Streamer.bot que envía mensajes al chat
CHAT_ACTION=SendChat
# Nombre de la acción en Streamer.bot que reembolsa puntos (opcional)
REFUND_ACTION=RefundRedemption
